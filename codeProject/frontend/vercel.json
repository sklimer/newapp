{
  "version": 2,
  "builds": [
    {
      "src": "codeProject/frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "codeProject/frontend/dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "codeProject/frontend/dist/$1"
    }
  ]
}